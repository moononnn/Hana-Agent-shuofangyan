{
  "manifestVersion": 2,
  "id": "shuo-fangyan",
  "name": "说方言",
  "version": "0.3.0",
  "entry": "index.js",
  "description": "小花老是说普通话，很无趣吧？一个能让小花说不同地区方言的应用，有四川话、北京话、东北话、台湾腔等等，还可以总结你的发言习惯，学你说话！",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/agents.read",
    "app/resources.read",
    "app/resources.write",
    "app/sessions.read",
    "app/models.infer",
    "app/services.provide"
  ],
  "contributes": {
    "cards": [
      {
        "id": "panel",
        "title": "说方言",
        "route": "/panel.html",
        "face": {
          "image": "assets/cover.png"
        },
        "realization": "page",
        "siteNavEntry": false,
        "cardForm": "flush",
        "titlebar": "solid"
      }
    ]
  },
  "icon": "assets/icon.png",
  "minAppVersion": "1.5.7-beta"
}
